<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!-- Building against a local build of MagicCSharp rather than the published packages: uncomment this,
         point it at wherever you ran `dotnet pack -o`, and set the MagicCSharp versions in
         Directory.Packages.props to match. See "Building against a local MagicCSharp" in README.md.
    <add key="local" value="/tmp/mcfeed" />
    -->
  </packageSources>
</configuration>
